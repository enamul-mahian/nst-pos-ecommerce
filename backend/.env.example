APP_NAME="New Singapur Telecom"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://newsingapurtele.com/api
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nst_production
DB_USERNAME=nst_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.newsingapurtele.com
SANCTUM_STATEFUL_DOMAINS=newsingapurtele.com,pos.newsingapurtele.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@newsingapurtele.com
MAIL_FROM_NAME="New Singapur Telecom"

FRONTEND_URL=https://newsingapurtele.com
POS_URL=https://pos.newsingapurtele.com

NST_BOOTSTRAP_ADMIN_NAME="Super Admin"
NST_BOOTSTRAP_ADMIN_EMAIL=admin@newsingapurtele.com
NST_BOOTSTRAP_ADMIN_PHONE=
NST_BOOTSTRAP_ADMIN_PASSWORD=
NST_SEED_DEFAULT_STAFF=false
NST_DEFAULT_STAFF_PASSWORD=

SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_ALLOW_RISK_LEVEL_ONE=false
SSLCOMMERZ_TIMEOUT_SECONDS=30

APK_BUILDER_SECRET=

# Optional official Brandfetch Logo API client ID
BRAND_FETCH_CLIENT_ID=
